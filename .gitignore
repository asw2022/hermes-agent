# ============================================================
#  Protective .gitignore for the home-directory repo.
#  Goal: keep secrets and personal bulk data OUT of git history.
#  Only files you explicitly `git add` will ever be tracked.
# ============================================================

# --- Secrets / credentials ---
.env
.env.*
*.env
.gitconfig
.git-credentials
.netrc
.npmrc
*.pem
*.key
id_rsa
id_*
ssh/
.ssh/
*-token*
*_token*
ha_token_file
ha_token_test.py
gen_key.py
gen_ssh_key.py
secrets.json
*.secret

# --- Tool / app config that may contain tokens ---
.claude.json
.claude/
.codex/
.copilot/
.config/
.cagent/
.openclaw/
.homeassistant/
.n8n/
.ollama/
.lmstudio-home-pointer
.docker/
.dotnet/
.dbus-keyrings/
.iptv_streamserver/
.gnutls/
.git-for-windows-updater
.agent-browser

# --- Caches / local state ---
.cache/
.local/
.dbus-keyrings/
.node_repl_history
.python_history
.bash_history
.profile

# --- Bulky personal data ---
AppData/
Documents/
Downloads/
Desktop/
Pictures/
Videos/
Music/
.anaconda/
.conda/
.android/

# --- Generic junk ---
node_modules
__pycache__/
*.log
*.db
*.sqlite
.DS_Store
Thumbs.db

# ============================================================
#  Tool-/App-Verzeichnisse (lokaler State, keine Projektdaten)
# ============================================================
.hermes/
.idlerc/
.ms-ad/
.qt_material/
.redhat/
.stalker_player_data/
.swt/
.ubuntupro/
.VirtualBox/
.vscode/
.vscode-shared/
.yawcam-ai/
.zenmap/
IntelGraphicsProfiles/
IPTV_PLAYER/

# ============================================================
#  Windows-Junctions / Symlinks auf AppData (NIEMALS committen
#  -> sonst Rekursion). Das sind KEINE echten Verzeichnisse.
# ============================================================
Anwendungsdaten/
Contacts/
Cookies/
Favorites/
CoPilot/

# ===========================================================
#  Windows-System-Ordner (nur Verknüpfungen/Shell-Daten)
# ===========================================================
Links/
Recent/
Searches/
SendTo/
Vorlagen/

# ===========================================================
#  Windows-Benutzerprofil-Daten (NIEMALS committen)
#  Registry-Hives, OneDrive, persoenliche Verzeichnisse,
#  GnuPG, WSL-Config, Spiele-Saves
# ===========================================================
NTUSER.DAT
NTUSER.DAT*
*.TM.blf
*.TMContainer*.regtrans-ms
USRCLASS.DAT
OneDrive/
Saved Games/
"Eigene Dateien/"
Startmenü/
Lokale Einstellungen/
Eigene Dateien/
Roaming/
# Rekursive Windows-Junctions im Profil (zeigen auf AppData -> Endlosschleife!)
Anwendungsdaten/
Application Data/
Local Settings/
.gnupg/
.gpg/
.wslconfig
Stalker Daten/
netwatchnet_log.txt
C:Usersnetwatchnet_log.txt
*netwatchnet_log.txt
adb.zip
tutorial_env/

# ===========================================================
#  Restliche persoenliche System-Artefakte (Logs, Ini, Reg,
#  exportierte Env-Vars, OSCam/IPTV-Channel-Lists, Bookmarks)
# ===========================================================
ntuser.ini
Environment Variables
*.log
cleanup_log.txt
netwatch_log.txt
ipconfig_out.txt
hermes_desktop_err.txt
hermes_desktop_out.txt
uninstall_log.txt
audio.txt
advanced_ip_scanner_*.bin
remove_adobe.reg
bookmarks*.html
favorites*.html
-1.14-windows.xml
cn.xml
cn2.xml
dip.xml
dip2.xml
exakt-user-regex-lib.xml
gn.xml
iran.xml
iran2.xml
tw.xml
tw2.xml
ua.xml
ua2.xml
ha_oscam_config.yaml
dashboard-config.json
filebrowser-settings.json
oscam_data.html

# ===========================================================
#  Raus aus dem Repo: venvs + Malware-Quarantäne + Junk
# ===========================================================
venv/
.venv/
__venv__/
security/quarantine_2026-07-17/
security/platform-tools.zip
security/platform-tools/
{
